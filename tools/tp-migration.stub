<?php

declare(strict_types=1);

use App\Support\SeededPolicyPages;
use App\Support\Url;
use Illuminate\Database\Migrations\Migration;
use Illuminate\Support\Facades\DB;

/**
 * The old shop's policy pages, in the owner's own words. (Lane TP)
 *
 * GENERATED by tools/tp-make-migration.php from docs/tp-source/<slug>.txt —
 * the text the owner pasted from kbeautybliss.com himself, kept verbatim.
 * App\Support\PastedPolicyText decides the structure (title, subheadings,
 * bullets, paragraphs, the mailto link) and changes no word;
 * OwnerPolicyPagesTest holds this file to that.
 *
 * ONLY A ROW STILL HOLDING THE SEEDED PLACEHOLDER IS WRITTEN —
 * App\Support\SeededPolicyPages::isSeeded() compares its words with the
 * seed's. A page the owner has edited in Pages → User pages, or one that does
 * not exist, is left exactly as it is, and a re-run changes nothing.
 *
 * ARABIC IS NOT WRITTEN. Pages carry Arabic title and content fields (the
 * translations table, Pages → User pages → Edit → Arabic), but no Arabic text
 * was supplied and none is invented; the Arabic shop prints the English until
 * one is entered there.
 *
 * No route changes: 2027_09_05_200200_clear_caches_policy_links is the
 * package's cache companion.
 */
return new class extends Migration
{
    private const PAGES = [
        /* PAGES */
    ];

    public function up(): void
    {
        // A link to a page of this shop is stored root-relative and carries the
        // deployment's base path (empty on the live shop), as OldSiteLinks
        // writes every imported link. mailto: is not touched.
        $base = rtrim(Url::raw('/'), '/');

        foreach (self::PAGES as $slug => $page) {
            $row = DB::table('pages')->where('slug', $slug)->first();

            if ($row === null || ! SeededPolicyPages::isSeeded($slug, $row->content)) {
                continue;
            }

            DB::table('pages')->where('id', $row->id)->update([
                'title' => $page['title'],
                'content' => str_replace('href="/', 'href="'.$base.'/', $page['content']),
                'updated_at' => now(),
            ]);
        }
    }

    public function down(): void
    {
        // Deliberately empty, like the seeds before it: the owner's own words
        // are not taken back off his shop by a rollback.
    }
};
