/node_modules
/vendor
/.idea
/.vscode

.env
.env.*
!.env.example
!env.staging.txt

/storage/*.key
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/framework/testing/.gitignore
/storage/logs/*.log

# Lane PERF's working directory: Lighthouse JSON/HTML, suite output and page
# dumps, tens of megabytes of it. CLAUDE.md's scratchpad landmine is why it is
# here and not in the session scratchpad -- that directory is SHARED between
# lanes and a generic filename in it is how one lane comes to report another's
# numbers. The reports that are a deliverable are committed under docs/.
/storage/perf-logs/
/storage/.kbb-installed

/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

.DS_Store
Thumbs.db
*.orig

# Editor and patch-system leftovers — see docs/REPO-STATE.md
*.backup-*
*.before-patch-*
app/*.zip

# Test databases. testing.sqlite is the developer's own; database/testing/ is
# where tests/bootstrap.php puts the per-process file each suite run migrates.
/database/testing.sqlite
/database/testing/

# PHPUnit's result cache. Untracked deliberately: it is what --order-by=defects
# reads, so committing one machine's copy would reorder everybody else's run.
/.phpunit.result.cache

# Agent worktrees — transient checkouts created per lane, never committed
/.claude/worktrees/

# Phone-sized copies of the shop's photographs, written into the web root at
# upload time and by the Media Library's batch. Generated, not source: they can
# always be made again from the originals, they are large, and a package that
# carried them could delete them on the next install. BuildPackage::NEVER_SHIP
# carries the same path for the same reason.
/public/img-cache/

# Integrator scratch: the local preview server launcher. Never shippable —
# UpdateGuard rejects any path outside app/, config/, database/, resources/,
# routes/ and public/build/, and a package carrying it is refused whole.
_preview.sh
_shot*.mjs

# Files the shoppable-video demo (and any real upload) writes into the preview
# web root. Generated, never source: App\Support\UgcDemoMedia writes them at
# seed time and Demo Content's Remove deletes them again.
public-web-root/uploads/

# Lane IG. The same rule one directory along, and it is not theoretical: the
# screenshot preview writes demo pictures into public/uploads/instagram/ and ten
# of them were committed by a `git add -A`, which would have shipped nine fake
# Instagram posts and an avatar inside an update package. `public/build/` stays
# tracked — it is the built asset bundle — so this is the uploads folder only.
public/uploads/

# Lane MB. The IMPORT's tree, and the same rule a third time along.
# Import\MediaSideloader fetches the owner's whole WooCommerce catalogue into
# public/wp-content/uploads/ (D-45: the paths in `products`.image already point
# there, so no shared image URL breaks), and this lane's tests write real bytes
# into it. Hundreds of a live shop's product photographs are not source, and a
# `git add -A` that caught them would put them inside an update package.
public/wp-content/

# ...and the preview database beside it. A stray .sqlite in the tree fails
# PackageSigningTest's `it holds no private key in this tree` scan, which is how
# this one was found.
/database/ig-preview.sqlite

# Built update packages, dropped at the repo root so the owner can download one
# from the app. The durable copy is storage/app/packages/.
/kbb-update-*.zip

# Lane worktree scratch — suite logs and one-off harnesses. CLAUDE.md puts a
# lane's logs in storage/<lane>-logs/ rather than the shared scratchpad; they
# are working notes, not source, and a `git add -A` that catches 100 KB of ANSI
# test output puts it in the package. The glob supersedes the single
# /storage/pdp-logs/ entry Lane PDP added for itself — same intent, every lane.
/storage/*-logs/
