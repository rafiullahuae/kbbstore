/node_modules
/vendor
/.idea
/.vscode

.env
.env.*
!.env.example
!env.staging.txt

/storage/*.key
/storage/app/*
!/storage/app/.gitignore
!/storage/app/public
/storage/app/public/*
!/storage/app/public/.gitignore
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/views/.gitignore
!/storage/framework/testing/.gitignore
/storage/logs/*.log
/storage/.kbb-installed

/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

.DS_Store
Thumbs.db
*.orig

# Editor and patch-system leftovers — see docs/REPO-STATE.md
*.backup-*
*.before-patch-*
app/*.zip

# Test databases. testing.sqlite is the developer's own; database/testing/ is
# where tests/bootstrap.php puts the per-process file each suite run migrates.
/database/testing.sqlite
/database/testing/

# PHPUnit's result cache. Untracked deliberately: it is what --order-by=defects
# reads, so committing one machine's copy would reorder everybody else's run.
/.phpunit.result.cache

# Agent worktrees — transient checkouts created per lane, never committed
/.claude/worktrees/

# Phone-sized copies of the shop's photographs, written into the web root at
# upload time and by the Media Library's batch. Generated, not source: they can
# always be made again from the originals, they are large, and a package that
# carried them could delete them on the next install. BuildPackage::NEVER_SHIP
# carries the same path for the same reason.
/public/img-cache/

# Integrator scratch: the local preview server launcher. Never shippable —
# UpdateGuard rejects any path outside app/, config/, database/, resources/,
# routes/ and public/build/, and a package carrying it is refused whole.
_preview.sh
_shot*.mjs
