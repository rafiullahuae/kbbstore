            "seo_home_title_ar": "\u0643\u064a \u0628\u064a\u0648\u062a\u064a \u0628\u0644\u064a\u0633 \u2014 \u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0627\u0644\u0643\u0648\u0631\u064a\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0641\u064a \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a",
            "seo_home_description_ar": "\u062a\u0633\u0648\u0651\u0642\u064a \u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0627\u0644\u0643\u0648\u0631\u064a\u0629 \u0628\u0627\u0644\u0628\u0634\u0631\u0629 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 100% \u0641\u064a \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0645\u0646 \u0643\u064a \u0628\u064a\u0648\u062a\u064a \u0628\u0644\u064a\u0633: \u0633\u064a\u0631\u0648\u0645 \u0648\u062a\u0648\u0646\u0631 \u0648\u0648\u0627\u0642\u064a \u0634\u0645\u0633 \u0645\u0646 \u0623\u0634\u0647\u0631 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0643\u0648\u0631\u064a\u0629\u060c \u0645\u0639 \u062a\u0648\u0635\u064a\u0644 \u0633\u0631\u064a\u0639 \u0644\u0643\u0644 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a.",
            "seo_default_description_ar": "\u0645\u0646\u062a\u062c\u0627\u062a \u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0627\u0644\u0643\u0648\u0631\u064a\u0629 \u0628\u0627\u0644\u0628\u0634\u0631\u0629 \u0648\u0627\u0644\u062c\u0645\u0627\u0644 \u0627\u0644\u0643\u0648\u0631\u064a \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0645\u0646 \u0623\u0634\u0647\u0631 \u0627\u0644\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u0643\u0648\u0631\u064a\u0629 \u0641\u064a \u0643\u064a \u0628\u064a\u0648\u062a\u064a \u0628\u0644\u064a\u0633\u060c \u0645\u062a\u062c\u0631\u0643 \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0641\u064a \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a \u0645\u0639 \u0627\u0644\u062a\u0648\u0635\u064a\u0644 \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a.",
            "seo_home_keywords_ar": "\u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0627\u0644\u0643\u0648\u0631\u064a\u0629 \u0628\u0627\u0644\u0628\u0634\u0631\u0629\u060c \u0645\u0646\u062a\u062c\u0627\u062a \u0643\u0648\u0631\u064a\u0629 \u0623\u0635\u0644\u064a\u0629\u060c \u0627\u0644\u062c\u0645\u0627\u0644 \u0627\u0644\u0643\u0648\u0631\u064a\u060c \u0643\u064a \u0628\u064a\u0648\u062a\u064a\u060c \u0643\u064a \u0628\u064a\u0648\u062a\u064a \u0628\u0644\u064a\u0633\u060c \u0645\u0633\u062a\u062d\u0636\u0631\u0627\u062a \u062a\u062c\u0645\u064a\u0644 \u0643\u0648\u0631\u064a\u0629\u060c \u0631\u0648\u062a\u064a\u0646 \u0627\u0644\u0639\u0646\u0627\u064a\u0629 \u0627\u0644\u0643\u0648\u0631\u064a\u060c \u0633\u064a\u0631\u0648\u0645 \u0643\u0648\u0631\u064a\u060c \u062a\u0648\u0646\u0631 \u0643\u0648\u0631\u064a\u060c \u0648\u0627\u0642\u064a \u0634\u0645\u0633 \u0643\u0648\u0631\u064a\u060c \u0645\u0646\u062a\u062c\u0627\u062a \u0643\u0648\u0631\u064a\u0629 \u0641\u064a \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a\u060c \u0645\u0646\u062a\u062c\u0627\u062a \u0643\u0648\u0631\u064a\u0629 \u0641\u064a \u062f\u0628\u064a\u060c \u0645\u062a\u062c\u0631 \u0645\u0646\u062a\u062c\u0627\u062a \u0643\u0648\u0631\u064a\u0629 \u0623\u0648\u0646\u0644\u0627\u064a\u0646",
            "home_sbc_tabs": "[{\"k\":\"acne\",\"on\":true,\"i\":\"acne\",\"l\":\"Acne\",\"la\":\"\u062d\u0628 \u0627\u0644\u0634\u0628\u0627\u0628\",\"h\":\"Acne & Blemishes\",\"ha\":\"\u062d\u0628 \u0627\u0644\u0634\u0628\u0627\u0628 \u0648\u0627\u0644\u0634\u0648\u0627\u0626\u0628\",\"t\":\"Cleanse gently, twice a day. Use a 2% BHA (salicylic acid) three or four nights a week to keep pores clear, calm breakouts with centella, and never skip a light, oil-free moisturiser \u2014 dehydrated skin makes more oil.\",\"ta\":\"\u0646\u0638\u0651\u0641\u064a \u0628\u0634\u0631\u062a\u0643\u0650 \u0628\u0644\u0637\u0641 \u0645\u0631\u062a\u064a\u0646 \u064a\u0648\u0645\u064a\u064b\u0627. \u0627\u0633\u062a\u062e\u062f\u0645\u064a BHA (\u062d\u0645\u0636 \u0627\u0644\u0633\u0627\u0644\u064a\u0633\u064a\u0644\u064a\u0643) \u0628\u062a\u0631\u0643\u064a\u0632 2% \u0645\u0646 \u062b\u0644\u0627\u062b \u0625\u0644\u0649 \u0623\u0631\u0628\u0639 \u0644\u064a\u0627\u0644\u064d \u0623\u0633\u0628\u0648\u0639\u064a\u064b\u0627 \u0644\u062a\u0628\u0642\u0649 \u0627\u0644\u0645\u0633\u0627\u0645 \u0646\u0638\u064a\u0641\u0629\u060c \u0648\u0647\u062f\u0651\u0626\u064a \u0627\u0644\u0628\u062b\u0648\u0631 \u0628\u0627\u0644\u0633\u0646\u062a\u064a\u0644\u0627\u060c \u0648\u0644\u0627 \u062a\u062a\u062e\u0637\u0651\u064a \u0645\u0631\u0637\u0651\u0628\u064b\u0627 \u062e\u0641\u064a\u0641\u064b\u0627 \u062e\u0627\u0644\u064a\u064b\u0627 \u0645\u0646 \u0627\u0644\u0632\u064a\u0648\u062a \u2014 \u0641\u0627\u0644\u0628\u0634\u0631\u0629 \u0627\u0644\u0639\u0637\u0634\u0649 \u062a\u0641\u0631\u0632 \u062f\u0647\u0648\u0646\u064b\u0627 \u0623\u0643\u062b\u0631.\",\"img\":\"\",\"imga\":\"\",\"src\":\"auto\",\"cats\":[],\"brands\":[],\"picks\":[],\"sort\":\"bestselling\",\"n\":0,\"u\":\"\"},{\"k\":\"hydration\",\"on\":true,\"i\":\"hydration\",\"l\":\"Hydration\",\"la\":\"\u0627\u0644\u062a\u0631\u0637\u064a\u0628\",\"h\":\"Dryness & Hydration\",\"ha\":\"\u0627\u0644\u062c\u0641\u0627\u0641 \u0648\u0627\u0644\u062a\u0631\u0637\u064a\u0628\",\"t\":\"Apply hyaluronic acid to damp skin, then seal it in with a ceramide cream. Skip hot water and harsh foaming cleansers \u2014 they strip the very barrier you are trying to repair.\",\"ta\":\"\u0636\u0639\u064a \u062d\u0645\u0636 \u0627\u0644\u0647\u064a\u0627\u0644\u0648\u0631\u0648\u0646\u064a\u0643 \u0639\u0644\u0649 \u0628\u0634\u0631\u0629 \u0631\u0637\u0628\u0629\u060c \u062b\u0645 \u0627\u062d\u0628\u0633\u064a\u0647 \u0628\u0643\u0631\u064a\u0645 \u0627\u0644\u0633\u064a\u0631\u0627\u0645\u064a\u062f. \u062a\u062c\u0646\u0651\u0628\u064a \u0627\u0644\u0645\u0627\u0621 \u0627\u0644\u0633\u0627\u062e\u0646 \u0648\u0627\u0644\u0645\u0646\u0638\u0651\u0641\u0627\u062a \u0627\u0644\u0631\u063a\u0648\u064a\u0629 \u0627\u0644\u0642\u0648\u064a\u0629 \u2014 \u0641\u0647\u064a \u062a\u064f\u0636\u0639\u0641 \u0627\u0644\u062d\u0627\u062c\u0632 \u0627\u0644\u0630\u064a \u062a\u062d\u0627\u0648\u0644\u064a\u0646 \u0625\u0635\u0644\u0627\u062d\u0647.\",\"img\":\"\",\"imga\":\"\",\"src\":\"auto\",\"cats\":[],\"brands\":[],\"picks\":[],\"sort\":\"bestselling\",\"n\":0,\"u\":\"\"},{\"k\":\"spots\",\"on\":true,\"i\":\"spots\",\"l\":\"Dark Spots\",\"la\":\"\u0627\u0644\u0628\u0642\u0639 \u0627\u0644\u062f\u0627\u0643\u0646\u0629\",\"h\":\"Dark Spots\",\"ha\":\"\u0627\u0644\u0628\u0642\u0639 \u0627\u0644\u062f\u0627\u0643\u0646\u0629\",\"t\":\"Niacinamide and tranexamic acid fade dark spots in 8\u201312 weeks \u2014 but only with SPF 50+ every single morning. Skip the sunscreen and the spots come back.\",\"ta\":\"\u064a\u062e\u0641\u0651\u0641 \u0627\u0644\u0646\u064a\u0627\u0633\u064a\u0646\u0627\u0645\u064a\u062f \u0648\u062d\u0645\u0636 \u0627\u0644\u062a\u0631\u0627\u0646\u064a\u0643\u0633\u0627\u0645\u064a\u0643 \u0627\u0644\u0628\u0642\u0639 \u0627\u0644\u062f\u0627\u0643\u0646\u0629 \u062e\u0644\u0627\u0644 8 \u0625\u0644\u0649 12 \u0623\u0633\u0628\u0648\u0639\u064b\u0627 \u2014 \u0644\u0643\u0646 \u0641\u0642\u0637 \u0645\u0639 \u0648\u0627\u0642\u064a \u0634\u0645\u0633 SPF 50+ \u0643\u0644 \u0635\u0628\u0627\u062d. \u0645\u0646 \u062f\u0648\u0646 \u0648\u0627\u0642\u064a \u0627\u0644\u0634\u0645\u0633 \u062a\u0639\u0648\u062f \u0627\u0644\u0628\u0642\u0639.\",\"img\":\"\",\"imga\":\"\",\"src\":\"auto\",\"cats\":[],\"brands\":[],\"picks\":[],\"sort\":\"bestselling\",\"n\":0,\"u\":\"\"},{\"k\":\"ageing\",\"on\":true,\"i\":\"ageing\",\"l\":\"Anti-Ageing\",\"la\":\"\u0645\u0643\u0627\u0641\u062d\u0629 \u0627\u0644\u0634\u064a\u062e\u0648\u062e\u0629\",\"h\":\"Fine Lines & Ageing\",\"ha\":\"\u0627\u0644\u062e\u0637\u0648\u0637 \u0627\u0644\u062f\u0642\u064a\u0642\u0629 \u0648\u0639\u0644\u0627\u0645\u0627\u062a \u0627\u0644\u062a\u0642\u062f\u0651\u0645 \u0641\u064a \u0627\u0644\u0633\u0646\",\"t\":\"Start retinol twice a week at night and build up slowly. In the morning: vitamin C, then SPF. Peptides and PDRN support firmness without the irritation.\",\"ta\":\"\u0627\u0628\u062f\u0626\u064a \u0628\u0627\u0644\u0631\u064a\u062a\u064a\u0646\u0648\u0644 \u0645\u0631\u062a\u064a\u0646 \u0623\u0633\u0628\u0648\u0639\u064a\u064b\u0627 \u0644\u064a\u0644\u064b\u0627 \u0648\u0632\u064a\u062f\u064a \u062a\u062f\u0631\u064a\u062c\u064a\u064b\u0627. \u0648\u0641\u064a \u0627\u0644\u0635\u0628\u0627\u062d: \u0641\u064a\u062a\u0627\u0645\u064a\u0646 \u0633\u064a \u062b\u0645 \u0648\u0627\u0642\u064a \u0627\u0644\u0634\u0645\u0633. \u0627\u0644\u0628\u0628\u062a\u064a\u062f\u0627\u062a \u0648PDRN \u062a\u062f\u0639\u0645 \u0634\u062f\u0651 \u0627\u0644\u0628\u0634\u0631\u0629 \u0645\u0646 \u062f\u0648\u0646 \u062a\u0647\u064a\u0651\u062c.\",\"img\":\"\",\"imga\":\"\",\"src\":\"auto\",\"cats\":[],\"brands\":[],\"picks\":[],\"sort\":\"bestselling\",\"n\":0,\"u\":\"\"},{\"k\":\"sensitive\",\"on\":true,\"i\":\"sensitive\",\"l\":\"Redness\",\"la\":\"\u0627\u0644\u0627\u062d\u0645\u0631\u0627\u0631\",\"h\":\"Redness & Sensitivity\",\"ha\":\"\u0627\u0644\u0627\u062d\u0645\u0631\u0627\u0631 \u0648\u0627\u0644\u062d\u0633\u0627\u0633\u064a\u0629\",\"t\":\"Keep it short: a gentle cleanser, a centella or heartleaf serum and a barrier cream. Patch-test anything new along your jaw for three days first.\",\"ta\":\"\u0627\u062c\u0639\u0644\u064a \u0631\u0648\u062a\u064a\u0646\u0643\u0650 \u0642\u0635\u064a\u0631\u064b\u0627: \u0645\u0646\u0638\u0651\u0641 \u0644\u0637\u064a\u0641\u060c \u0648\u0633\u064a\u0631\u0648\u0645 \u0628\u0627\u0644\u0633\u0646\u062a\u064a\u0644\u0627 \u0623\u0648 \u0627\u0644\u0647\u0627\u0631\u062a\u0644\u064a\u0641\u060c \u0648\u0643\u0631\u064a\u0645 \u064a\u062d\u0645\u064a \u0627\u0644\u062d\u0627\u062c\u0632. \u062c\u0631\u0651\u0628\u064a \u0623\u064a \u0645\u0646\u062a\u062c \u062c\u062f\u064a\u062f \u0639\u0644\u0649 \u062e\u0637 \u0627\u0644\u0641\u0643 \u0644\u0645\u062f\u0629 \u062b\u0644\u0627\u062b\u0629 \u0623\u064a\u0627\u0645 \u0623\u0648\u0644\u064b\u0627.\",\"img\":\"\",\"imga\":\"\",\"src\":\"auto\",\"cats\":[],\"brands\":[],\"picks\":[],\"sort\":\"bestselling\",\"n\":0,\"u\":\"\"},{\"k\":\"pores\",\"on\":true,\"i\":\"pores\",\"l\":\"Pores\",\"la\":\"\u0627\u0644\u0645\u0633\u0627\u0645\",\"h\":\"Pores & Oil Control\",\"ha\":\"\u0627\u0644\u0645\u0633\u0627\u0645 \u0648\u0627\u0644\u062a\u062d\u0643\u0651\u0645 \u0641\u064a \u0627\u0644\u062f\u0647\u0648\u0646\",\"t\":\"Oil-cleanse first to dissolve sebum, follow with a BHA toner, and use a clay mask once a week. Still moisturise \u2014 stripped skin only makes more oil.\",\"ta\":\"\u0627\u0628\u062f\u0626\u064a \u0628\u0645\u0646\u0638\u0651\u0641 \u0632\u064a\u062a\u064a \u0644\u0625\u0630\u0627\u0628\u0629 \u0627\u0644\u062f\u0647\u0648\u0646\u060c \u062b\u0645 \u062a\u0648\u0646\u0631 BHA\u060c \u0648\u0627\u0633\u062a\u062e\u062f\u0645\u064a \u0642\u0646\u0627\u0639 \u0627\u0644\u0637\u064a\u0646 \u0645\u0631\u0629 \u0623\u0633\u0628\u0648\u0639\u064a\u064b\u0627. \u0648\u0644\u0627 \u062a\u062a\u062e\u0644\u0651\u064a \u0639\u0646 \u0627\u0644\u0645\u0631\u0637\u0651\u0628 \u2014 \u0641\u0627\u0644\u0628\u0634\u0631\u0629 \u0627\u0644\u062c\u0627\u0641\u0629 \u062a\u0641\u0631\u0632 \u0627\u0644\u0645\u0632\u064a\u062f \u0645\u0646 \u0627\u0644\u062f\u0647\u0648\u0646.\",\"img\":\"\",\"imga\":\"\",\"src\":\"auto\",\"cats\":[],\"brands\":[],\"picks\":[],\"sort\":\"bestselling\",\"n\":0,\"u\":\"\"},{\"k\":\"dull\",\"on\":true,\"i\":\"dull\",\"l\":\"Glow\",\"la\":\"\u0627\u0644\u0625\u0634\u0631\u0627\u0642\u0629\",\"h\":\"Dullness & Glow\",\"ha\":\"\u0627\u0644\u0628\u0647\u062a\u0627\u0646 \u0648\u0627\u0644\u0625\u0634\u0631\u0627\u0642\u0629\",\"t\":\"Vitamin C in the morning, a gentle AHA or rice exfoliant two nights a week, and a hydrating essence every day. Glow comes from skin that is smooth and well hydrated.\",\"ta\":\"\u0641\u064a\u062a\u0627\u0645\u064a\u0646 \u0633\u064a \u0635\u0628\u0627\u062d\u064b\u0627\u060c \u0648\u0645\u0642\u0634\u0651\u0631 \u0644\u0637\u064a\u0641 \u0628\u0623\u062d\u0645\u0627\u0636 AHA \u0623\u0648 \u0627\u0644\u0623\u0631\u0632 \u0644\u064a\u0644\u062a\u064a\u0646 \u0623\u0633\u0628\u0648\u0639\u064a\u064b\u0627\u060c \u0648\u062e\u0644\u0627\u0635\u0629 \u0645\u0631\u0637\u0651\u0628\u0629 \u0643\u0644 \u064a\u0648\u0645. \u0627\u0644\u0625\u0634\u0631\u0627\u0642\u0629 \u062a\u0623\u062a\u064a \u0645\u0646 \u0628\u0634\u0631\u0629 \u0646\u0627\u0639\u0645\u0629 \u0648\u0645\u0631\u0637\u0651\u0628\u0629 \u062c\u064a\u062f\u064b\u0627.\",\"img\":\"\",\"imga\":\"\",\"src\":\"auto\",\"cats\":[],\"brands\":[],\"picks\":[],\"sort\":\"bestselling\",\"n\":0,\"u\":\"\"},{\"k\":\"sun\",\"on\":true,\"i\":\"sun\",\"l\":\"Sun Care\",\"la\":\"\u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0645\u0646 \u0627\u0644\u0634\u0645\u0633\",\"h\":\"Sun Protection\",\"ha\":\"\u0627\u0644\u062d\u0645\u0627\u064a\u0629 \u0645\u0646 \u0627\u0644\u0634\u0645\u0633\",\"t\":\"SPF 50+ PA++++ every morning \u2014 even indoors by a window. Use two finger-lengths for face and neck, and reapply every two hours outdoors in the UAE sun.\",\"ta\":\"\u0627\u0633\u062a\u062e\u062f\u0645\u064a \u0648\u0627\u0642\u064a \u0634\u0645\u0633 SPF 50+ PA++++ \u0643\u0644 \u0635\u0628\u0627\u062d \u2014 \u062d\u062a\u0649 \u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0646\u0632\u0644 \u0642\u0631\u0628 \u0627\u0644\u0646\u0627\u0641\u0630\u0629. \u0636\u0639\u064a \u0645\u0627 \u064a\u0639\u0627\u062f\u0644 \u0637\u0648\u0644 \u0625\u0635\u0628\u0639\u064a\u0646 \u0644\u0644\u0648\u062c\u0647 \u0648\u0627\u0644\u0631\u0642\u0628\u0629\u060c \u0648\u062c\u062f\u0651\u062f\u064a\u0647 \u0643\u0644 \u0633\u0627\u0639\u062a\u064a\u0646 \u0641\u064a \u0627\u0644\u062e\u0627\u0631\u062c \u062a\u062d\u062a \u0634\u0645\u0633 \u0627\u0644\u0625\u0645\u0627\u0631\u0627\u062a.\",\"img\":\"\",\"imga\":\"\",\"src\":\"auto\",\"cats\":[],\"brands\":[],\"picks\":[],\"sort\":\"bestselling\",\"n\":0,\"u\":\"\"},{\"k\":\"dullskin\",\"on\":true,\"i\":\"dullskin\",\"l\":\"Dull Skin\",\"la\":\"\u0627\u0644\u0628\u0634\u0631\u0629 \u0627\u0644\u0628\u0627\u0647\u062a\u0629\",\"h\":\"Dull Skin\",\"ha\":\"\u0627\u0644\u0628\u0634\u0631\u0629 \u0627\u0644\u0628\u0627\u0647\u062a\u0629\",\"t\":\"Dull skin is usually dead cells and thirst. Exfoliate gently twice a week with AHA or rice enzymes, add vitamin C or niacinamide every morning, hydrate in layers \u2014 and always finish with SPF.\",\"ta\":\"\u063a\u0627\u0644\u0628\u064b\u0627 \u0645\u0627 \u064a\u0643\u0648\u0646 \u0628\u0647\u062a\u0627\u0646 \u0627\u0644\u0628\u0634\u0631\u0629 \u0628\u0633\u0628\u0628 \u0627\u0644\u062e\u0644\u0627\u064a\u0627 \u0627\u0644\u0645\u064a\u062a\u0629 \u0648\u0627\u0644\u062c\u0641\u0627\u0641. \u0642\u0634\u0651\u0631\u064a \u0628\u0644\u0637\u0641 \u0645\u0631\u062a\u064a\u0646 \u0623\u0633\u0628\u0648\u0639\u064a\u064b\u0627 \u0628\u0623\u062d\u0645\u0627\u0636 AHA \u0623\u0648 \u0625\u0646\u0632\u064a\u0645\u0627\u062a \u0627\u0644\u0623\u0631\u0632\u060c \u0648\u0623\u0636\u064a\u0641\u064a \u0641\u064a\u062a\u0627\u0645\u064a\u0646 \u0633\u064a \u0623\u0648 \u0627\u0644\u0646\u064a\u0627\u0633\u064a\u0646\u0627\u0645\u064a\u062f \u0643\u0644 \u0635\u0628\u0627\u062d\u060c \u0648\u0631\u0637\u0651\u0628\u064a \u0639\u0644\u0649 \u0637\u0628\u0642\u0627\u062a \u2014 \u0648\u0627\u062e\u062a\u0645\u064a \u062f\u0627\u0626\u0645\u064b\u0627 \u0628\u0648\u0627\u0642\u064a \u0627\u0644\u0634\u0645\u0633.\",\"img\":\"\",\"imga\":\"\",\"src\":\"auto\",\"cats\":[],\"brands\":[],\"picks\":[],\"sort\":\"bestselling\",\"n\":0,\"u\":\"\"}]",
