<?xml version="1.0" encoding="UTF-8"?>
<!--
    The same suite as phpunit.xml, pointed at a real MySQL/MariaDB.

    Why this file exists: tests run on SQLite, production runs MySQL, and the
    gap between the two dialects has caused two outages that the green SQLite
    suite could not see (see docs/MYSQL-PARITY.md). This config is the other
    half of the suite — same tests, real dialect.

        vendor/bin/pest -c phpunit-mysql.xml (add the compact flag)

    The connection is `mysql` with Laravel's `strict => true`, which issues
    SET SESSION sql_mode='ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,
    NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION'. The live
    host's sql_mode is unknown, so the suite is pinned to the strictest
    realistic setting rather than to a guess.

    force="true" matters: without it PHPUnit leaves an already-exported
    DB_CONNECTION alone and the run silently falls back to SQLite — exactly
    the false green this file exists to prevent. So force stays on everything,
    including DB_DATABASE, and the one value a lane actually needs to change
    arrives under a name of its own instead:

        KBB_TEST_DB=kbb_test_ce vendor/bin/pest -c phpunit-mysql.xml

    tests/bootstrap.php applies it. PHPUnit runs this <php> block BEFORE the
    bootstrap script, so that is the only point at which a forced value can
    still be changed — and it is changed by a variable nothing else reads,
    rather than by deleting the force that protects the rest of the file.

    The database below is the default, and it is SHARED. Two worktrees running
    this config at once without KBB_TEST_DB drop the schema under each other
    mid-run and report hundreds of failures belonging to neither of them.
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include><directory>app</directory></include>
    </source>
    <php>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="DB_CONNECTION" value="mysql" force="true"/>
        <env name="DB_HOST" value="127.0.0.1" force="true"/>
        <env name="DB_PORT" value="3306" force="true"/>
        <env name="DB_DATABASE" value="kbb_test" force="true"/>
        <env name="DB_USERNAME" value="kbb" force="true"/>
        <env name="DB_PASSWORD" value="kbb" force="true"/>
        <env name="DB_CHARSET" value="utf8mb4" force="true"/>
        <env name="DB_COLLATION" value="utf8mb4_unicode_ci" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
    </php>
</phpunit>
